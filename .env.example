# Destino do formulário (Zapier, Make, n8n, etc.)
# A tela "Criar novo webhook" do Pipedrive é o caminho inverso:
# o Pipedrive avisa uma URL quando algo muda no CRM.
# Para o lead do site entrar no Pipedrive, use o token da API abaixo
# ou aponte LEAD_WEBHOOK_URL para um cenário do Make/Zapier que crie a Pessoa.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_USER=
LEAD_WEBHOOK_PASSWORD=

# Opcional: cria Organização + Pessoa + Lead no Pipedrive
# Configurações > Preferências pessoais > API
PIPEDRIVE_API_TOKEN=
# Ex.: suaempresa  →  https://suaempresa.pipedrive.com
PIPEDRIVE_COMPANY_DOMAIN=
